# Copiar para .env.docker no servidor e preencher. Este ficheiro NÃO vai para o git com valores reais.
APP_NAME="Cirurgia Colorectal - ULS Região de Leiria"
APP_ENV=production
APP_DEBUG=false
# Gerar com:  docker compose run --rm --no-deps app php artisan key:generate --show
# (ou reutilizar a chave do .env local, para manter as sessões e cookies válidos)
APP_KEY=
# O endereço pelo qual os utilizadores acedem (com https:// se houver proxy com TLS)
APP_URL=http://IP-OU-NOME-DO-SERVIDOR:8080
APP_TIMEZONE=Europe/Lisbon
APP_LOCALE=pt
APP_FALLBACK_LOCALE=pt
LOG_CHANNEL=stderr

DB_CONNECTION=mysql
DB_DATABASE=cr_base
DB_USERNAME=root
# A mesma password nas duas linhas (a base de dados só aceita ligações do próprio servidor e do contentor da app)
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=cr_base

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
# Só correr migrações quando se pedir (depois de um backup)
RUN_MIGRATIONS=false

# Com proxy HTTPS à frente (recomendado): TRUSTED_PROXIES=*  e  SESSION_SECURE_COOKIE=true
# TRUSTED_PROXIES=*
# SESSION_SECURE_COOKIE=true
